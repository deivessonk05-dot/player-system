
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#070b14">
<title>PLAYER SYSTEM</title>
<style>
:root {
  --bg:#070b14;
  --panel:#101a2b;
  --blue:#48baff;
  --cyan:#70eaff;
  --muted:#8294ad;
  --line:#203650;
}
*{box-sizing:border-box}
body{
  margin:0;background:
  radial-gradient(ellipse at 50% -20%,#173c65 0%,transparent 55%),
  var(--bg);
  color:#eef7ff;font-family:Arial,sans-serif;
  min-height:100vh;
}
header{
  padding:22px 18px 15px;
  border-bottom:1px solid var(--line);
  display:flex;justify-content:space-between;
  align-items:center;
}
.logo{font-size:19px;font-weight:900;letter-spacing:2px}
.logo span{color:var(--blue)}
.status{font-size:10px;color:#63e6bd;letter-spacing:1px}
main{max-width:650px;margin:auto;padding:18px}
.eyebrow{font-size:10px;color:var(--blue);letter-spacing:3px}
h1{font-size:27px;margin:8px 0}
.subtitle{color:var(--muted);font-size:12px}
.panel{
  background:linear-gradient(145deg,#14243a,#0b1220);
  border:1px solid var(--line);
  border-radius:15px;padding:18px;margin:15px 0;
  box-shadow:0 8px 30px #0005;
}
.profile{display:flex;align-items:center;gap:15px}
.avatar{
  width:65px;height:65px;border:1px solid var(--blue);
  border-radius:13px;display:grid;place-items:center;
  font-size:30px;color:var(--cyan);
  background:#102d49;box-shadow:0 0 22px #38baff25;
}
.small{font-size:11px;color:var(--muted)}
.rank{color:var(--cyan);font-size:12px;font-weight:bold}
.level{font-size:25px;font-weight:900}
.xphead{display:flex;justify-content:space-between;
font-size:11px;margin:20px 0 8px}
.track{height:9px;background:#26374c;border-radius:20px;overflow:hidden}
.fill{height:100%;width:0%;background:linear-gradient(90deg,#258cff,#75edff);
box-shadow:0 0 12px #45caff;transition:.4s}
.stats{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}
.stat{
  background:#0b1422;border:1px solid var(--line);
  border-radius:11px;padding:13px;
}
.stat-name{font-size:10px;color:var(--muted);letter-spacing:1px}
.stat-value{font-size:23px;font-weight:bold;margin-top:7px}
.stat-icon{color:var(--blue);float:right}
.section-title{font-size:14px;letter-spacing:1px;margin-bottom:14px}
.mission{
  display:flex;align-items:center;gap:12px;
  padding:13px 0;border-bottom:1px solid #243449;
}
.mission:last-child{border:0}
.mission-icon{
  width:40px;height:40px;display:grid;place-items:center;
  background:#102a43;border-radius:10px;font-size:19px;
}
.mission-info{flex:1}
.mission-name{font-size:13px;font-weight:bold}
.reward{font-size:10px;color:var(--blue);margin-top:5px}
.complete{
  border:1px solid #278bc4;background:#102d47;
  color:#8ddfff;border-radius:8px;padding:9px 10px;
  font-size:10px;font-weight:bold;
}
.complete:disabled{opacity:.4;color:#72d9b4;border-color:#285a4c}
button{cursor:pointer}
.notice{
  text-align:center;color:var(--muted);
  font-size:10px;line-height:1.7;padding:10px;
}
nav{
  display:flex;justify-content:space-around;
  position:sticky;bottom:0;background:#09111e;
  border-top:1px solid var(--line);padding:14px 4px;
}
nav a{font-size:10px;color:var(--muted);text-decoration:none}
nav a:first-child{color:var(--cyan)}
footer{text-align:center;padding:20px;color:#536a85;font-size:9px;letter-spacing:2px}
@media(min-width:500px){
  .stats{grid-template-columns:repeat(3,1fr)}
}
</style>
</head>
<body>
<header>
  <div class="logo">PLAYER <span>SYSTEM</span></div>
  <div class="status">● SYSTEM ONLINE</div>
</header>

<main>
  <div class="eyebrow">SISTEMA DE EVOLUÇÃO PESSOAL</div>
  <h1>Bem-vindo, Jogador.</h1>
  <div class="subtitle">Sua evolução começa com a próxima missão.</div>

  <section class="panel">
    <div class="profile">
      <div class="avatar">⚔</div>
      <div>
        <div class="small">JOGADOR IDENTIFICADO</div>
        <div style="font-size:19px;font-weight:bold">PLAYER</div>
        <div class="rank" id="rank">RANK E — INICIANTE</div>
      </div>
    </div>
    <div class="xphead">
      <span id="level">NÍVEL 1</span>
      <span id="xptext">0 / 100 XP</span>
    </div>
    <div class="track"><div class="fill" id="xpbar"></div></div>
    <div class="small" style="margin-top:10px" id="next">100 XP para o próximo nível</div>
  </section>

  <div class="section-title">▰ STATUS DO JOGADOR</div>
  <section class="panel">
    <div class="stats">
      <div class="stat">
        <span class="stat-icon">✦</span>
        <div class="stat-name">FORÇA</div>
        <div class="stat-value" id="strength">1</div>
      </div>
      <div class="stat">
        <span class="stat-icon">◈</span>
        <div class="stat-name">RESISTÊNCIA</div>
        <div class="stat-value" id="endurance">1</div>
      </div>
      <div class="stat">
        <span class="stat-icon">➤</span>
        <div class="stat-name">AGILIDADE</div>
        <div class="stat-value" id="agility">1</div>
      </div>
      <div class="stat">
        <span class="stat-icon">♥</span>
        <div class="stat-name">VITALIDADE</div>
        <div class="stat-value" id="vitality">1</div>
      </div>
      <div class="stat">
        <span class="stat-icon">◆</span>
        <div class="stat-name">DISCIPLINA</div>
        <div class="stat-value" id="discipline">1</div>
      </div>
      <div class="stat">
        <span class="stat-icon">★</span>
        <div class="stat-name">MOEDAS</div>
        <div class="stat-value" id="coins">0</div>
      </div>
    </div>
  </section>

  <div class="section-title">▰ MISSÕES DIÁRIAS</div>
  <section class="panel">
    <div class="small" style="margin-bottom:14px">
      Complete desafios adequados ao seu ritmo.
    </div>
    <div id="missions"></div>
  </section>

  <section class="panel">
    <div class="eyebrow">MENSAGEM DO SISTEMA</div>
    <h2 style="font-size:17px">O despertar começou.</h2>
    <div class="small">
      Não é necessário ser perfeito. Evolua gradualmente,
      respeite seus limites e mantenha a consistência.
    </div>
  </section>

  <div class="notice">
    SEU PROGRESSO É SALVO NESTE DISPOSITIVO.<br>
    MISSÕES PODEM SER ADAPTADAS AO SEU NÍVEL.
  </div>
</main>

<nav>
  <a href="#top">⌂ INÍCIO</a>
  <a href="#missions">⚔ MISSÕES</a>
  <a href="#strength">◈ STATUS</a>
</nav>

<footer>PLAYER SYSTEM · VERSION 1.0 · AWAKENING</footer>

<script>
const initial = {
  xp:0, level:1, coins:0,
  stats:{strength:1,endurance:1,agility:1,
  vitality:1,discipline:1},
  completed:{}
};

let data;
try {
  data=JSON.parse(localStorage.getItem("playerSystemSave"))||initial;
} catch(e) { data=initial; }

const missions=[
  {id:"m1",icon:"💪",name:"Treinamento físico",
   desc:"Faça um treino adequado ao seu nível.",xp:30,stat:"strength"},
  {id:"m2",icon:"🚶",name:"Movimente-se",
   desc:"Faça uma caminhada ou atividade leve.",xp:15,stat:"endurance"},
  {id:"m3",icon:"💧",name:"Hidratação",
   desc:"Mantenha uma boa hidratação durante o dia.",xp:10,stat:"vitality"},
  {id:"m4",icon:"📚",name:"Desenvolvimento mental",
   desc:"Estude ou aprenda algo por 20 minutos.",xp:20,stat:"discipline"},
  {id:"m5",icon:"🧘",name:"Mobilidade e recuperação",
   desc:"Faça alongamentos leves e respeite seu corpo.",xp:15,stat:"agility"}
];

function save(){
  localStorage.setItem("playerSystemSave",JSON.stringify(data));
}

function rank(){
  if(data.level>=50)return "RANK S — ELITE";
  if(data.level>=30)return "RANK A — AVANÇADO";
  if(data.level>=20)return "RANK B — EXPERIENTE";
  if(data.level>=10)return "RANK C — DESENVOLVIDO";
  if(data.level>=5)return "RANK D — DESPERTANDO";
  return "RANK E — INICIANTE";
}

function render(){
  document.getElementById("level").textContent="NÍVEL "+data.level;
  document.getElementById("xptext").textContent=
    data.xp+" / "+(data.level*100)+" XP";
  document.getElementById("xpbar").style.width=
    Math.min(100,data.xp/(data.level*100)*100)+"%";
  document.getElementById("rank").textContent=rank();
  document.getElementById("next").textContent=
    (data.level*100-data.xp)+" XP para o próximo nível";
  document.getElementById("coins").textContent=data.coins;

  Object.keys(data.stats).forEach(key=>{
    document.getElementById(key).textContent=data.stats[key];
  });

  const today=new Date().toLocaleDateString("en-CA");
  document.getElementById("missions").innerHTML=missions.map(m=>{
    const done=data.completed[today+"_"+m.id];
    return `<div class="mission">
      <div class="mission-icon">${m.icon}</div>
      <div class="mission-info">
        <div class="mission-name">${m.name}</div>
        <div class="reward">${m.xp} XP · ${m.desc}</div>
      </div>
      <button class="complete" ${done?"disabled":""}
      onclick="completeMission('${m.id}')">
      ${done?"FEITA":"CONCLUIR"}
      </button>
    </div>`;
  }).join("");
}

function completeMission(id){
  const today=new Date().toLocaleDateString("en-CA");
  const key=today+"_"+id;
  if(data.completed[key])return;

  const mission=missions.find(m=>m.id===id);
  if(!mission)return;

  data.completed[key]=true;
  data.xp+=mission.xp;
  data.coins+=5;
  data.stats[mission.stat]++;

  let leveled=false;
  while(data.xp>=data.level*100){
    data.xp-=data.level*100;
    data.level++;
    leveled=true;
  }

  save();
  render();

  if(leveled){
    alert("LEVEL UP! Você alcançou o nível "+data.level+"!");
  }else{
    alert("MISSÃO CONCLUÍDA! +"+mission.xp+" XP");
  }
}

render();
</script>
</body>
</html>
