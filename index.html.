<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#070b14">
<meta name="description" content="PLAYER SYSTEM — Physical Evolution: evolução física, disciplina e progresso pessoal.">
<link rel="manifest" href="manifest.webmanifest">
<link rel="icon" href="icon.svg" type="image/svg+xml">
<title>PLAYER SYSTEM | PHYSICAL EVOLUTION</title>
<style>
:root{--bg:#060a12;--panel:#0d1625;--panel2:#101e31;--line:#1d4164;--blue:#48baff;--cyan:#74e7ff;--text:#e8f5ff;--muted:#8ba5bd;--green:#65e6ad;--gold:#ffd36b;--red:#ff7185;--purple:#b69aff}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:radial-gradient(ellipse at 50% -20%,#14365a 0%,transparent 45%),var(--bg);color:var(--text);font:15px/1.45 system-ui,-apple-system,Segoe UI,sans-serif;min-height:100vh}
button,input{font:inherit}button{cursor:pointer;color:inherit}.app{max-width:1050px;margin:auto;padding:16px 14px 100px}.top{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:18px}.brand{font-weight:900;letter-spacing:2px;color:var(--cyan);font-size:14px}.brand small{display:block;color:var(--muted);font-size:9px;letter-spacing:3px;font-weight:600}.status{font-size:10px;color:var(--green);border:1px solid #286c5b;padding:5px 8px;border-radius:20px}
.hero{border:1px solid #28618b;background:linear-gradient(135deg,#10253cdd,#091321f2);padding:20px;border-radius:16px;box-shadow:0 0 35px #1689d51c;position:relative;overflow:hidden}.hero:after{content:"";position:absolute;width:190px;height:190px;border:1px solid #42bfff33;border-radius:50%;right:-75px;top:-85px;box-shadow:0 0 0 18px #42bfff0a,0 0 0 38px #42bfff08}
.kicker{font-size:10px;letter-spacing:2px;color:var(--blue);font-weight:800}.player{font-size:25px;font-weight:900;letter-spacing:1px;margin:5px 0}.sub{color:var(--muted);font-size:12px}.levelrow{display:flex;justify-content:space-between;align-items:end;margin-top:20px;gap:10px}.level{font-size:32px;font-weight:900;color:var(--cyan)}.xp{font-size:12px;color:var(--muted);text-align:right}.bar{height:9px;background:#07101b;border:1px solid #214360;border-radius:20px;overflow:hidden;margin-top:8px}.bar span{display:block;height:100%;background:linear-gradient(90deg,#218ee9,#78edff);width:0;transition:width .3s;box-shadow:0 0 12px #42bfff}
.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin-top:14px}.card{background:linear-gradient(145deg,#0f1b2b,#0a121e);border:1px solid #1a3b59;border-radius:14px;padding:15px;min-width:0}.wide{grid-column:1/-1}.card h2{font-size:13px;letter-spacing:1.3px;color:var(--cyan);margin:0 0 12px}.muted{color:var(--muted)}.big{font-size:23px;font-weight:850}.tiny{font-size:11px;color:var(--muted)}.stats{display:grid;grid-template-columns:repeat(2,1fr);gap:8px}.stat{background:#0a1421;border:1px solid #193752;padding:10px;border-radius:10px}.stat b{display:block;font-size:18px}.stat span{font-size:10px;color:var(--muted);letter-spacing:.7px}
nav{display:flex;gap:7px;overflow:auto;padding:10px 0 4px;position:sticky;top:0;z-index:5;background:#060a12ed;backdrop-filter:blur(10px)}nav button,.btn{border:1px solid #245178;background:#10243a;border-radius:9px;padding:9px 12px;font-size:12px;white-space:nowrap}nav button.active,.btn.primary{background:#1268a5;border-color:#51c4ff}.btn:disabled{opacity:.4;cursor:not-allowed}
.section{display:none}.section.active{display:block}.mission,.exercise,.achievement,.skill,.historyitem{padding:11px;border:1px solid #1b3b56;border-radius:10px;background:#0a1420;margin:8px 0}.mission{display:flex;align-items:center;gap:10px}.mission input{accent-color:#45c6ff;width:18px;height:18px}.mission.done{opacity:.55;border-color:#28775c}.mission.done .mname{text-decoration:line-through}.mname{font-weight:700;font-size:13px}.reward{margin-left:auto;color:var(--gold);font-size:11px;white-space:nowrap}
.daytabs{display:flex;gap:6px;overflow:auto;margin:8px 0 12px}.daytabs button{background:#0c1827;border:1px solid #1d4164;border-radius:8px;padding:8px 11px;font-size:11px}.daytabs button.active{border-color:var(--cyan);color:var(--cyan)}
.exercise{display:flex;justify-content:space-between;gap:12px;align-items:center}.exercise strong{font-size:13px}.exercise small{display:block;color:var(--muted);font-size:11px}.exercise .sets{color:var(--cyan);font-size:12px;text-align:right;white-space:nowrap}
.timer{text-align:center;padding:18px}.clock{font-size:48px;font-weight:900;letter-spacing:2px;color:var(--cyan);font-variant-numeric:tabular-nums}.timercontrols{display:flex;justify-content:center;gap:8px;flex-wrap:wrap}
.attr{display:grid;grid-template-columns:1fr auto;gap:6px;margin:10px 0;font-size:12px}.attr .bar{grid-column:1/-1;margin:0}
.footer{position:fixed;bottom:0;left:0;right:0;text-align:center;padding:8px;background:#060a12ed;color:#6d879e;font-size:9px;letter-spacing:1.5px;border-top:1px solid #17314a}
.toast{position:fixed;left:50%;bottom:65px;transform:translateX(-50%);background:#12304a;border:1px solid #54c9ff;padding:10px 14px;border-radius:10px;font-size:12px;z-index:20;display:none;max-width:90vw}
textarea{width:100%;background:#07111d;color:var(--text);border:1px solid #244560;border-radius:8px;padding:10px;min-height:65px}
@media(min-width:700px){.grid{grid-template-columns:repeat(3,minmax(0,1fr))}.wide{grid-column:span 2}.hero{padding:26px}.player{font-size:32px}}
</style>
</head>
<body>
<div class="app">
<header class="top"><div class="brand">PLAYER SYSTEM<small>PHYSICAL EVOLUTION · v2.0</small></div><div class="status" id="saveStatus">● SALVAMENTO LOCAL ATIVO</div></header>
<section class="hero">
 <div class="kicker">SISTEMA ONLINE / PROTOCOLO DO JOGADOR</div>
 <div class="player" id="playerName">JOGADOR</div><div class="sub">Sua evolução começa com a próxima missão.</div>
 <div class="levelrow"><div><div class="tiny">NÍVEL ATUAL</div><div class="level" id="level">01</div></div><div class="xp"><b id="xpText">0 / 100 EXP</b><div>EXPERIÊNCIA</div></div></div>
 <div class="bar"><span id="xpBar"></span></div>
</section>
<nav id="nav">
<button class="active" data-tab="dashboard">Painel</button><button data-tab="missions">Missões</button><button data-tab="training">Treino</button><button data-tab="attributes">Atributos</button><button data-tab="history">Histórico</button><button data-tab="rewards">Conquistas</button>
</nav>
<section class="section active" id="dashboard">
<div class="grid">
 <article class="card"><h2>STATUS DO JOGADOR</h2><div class="stats"><div class="stat"><span>SEQUÊNCIA</span><b id="streak">0 dias</b></div><div class="stat"><span>TREINOS</span><b id="workouts">0</b></div><div class="stat"><span>MISSÕES</span><b id="missionsDone">0</b></div><div class="stat"><span>CLASSE</span><b id="rank">Novato</b></div></div></article>
 <article class="card"><h2>ATRIBUTOS PRINCIPAIS</h2><div id="miniAttrs"></div></article>
 <article class="card wide"><h2>MISSÃO PRIORITÁRIA DE HOJE</h2><div id="todayMission"></div></article>
 <article class="card"><h2>CRONÔMETRO DE DESCANSO</h2><div class="timer"><div class="clock" id="clock">01:30</div><div class="timercontrols"><button class="btn primary" id="timerStart">Iniciar</button><button class="btn" id="timerReset">Reiniciar</button></div><div class="tiny" style="margin-top:8px">Descanso recomendado: 60–120 segundos</div></div></article>
 <article class="card"><h2>PROTOCOLO SEMANAL</h2><div class="tiny">5 dias de treino · 2 dias de recuperação</div><div id="weekStatus" style="margin-top:10px"></div></article>
</div></section>
<section class="section" id="missions"><div class="grid"><article class="card wide"><h2>MISSÕES DIÁRIAS</h2><p class="tiny">Conclua com honestidade. A experiência é sua, não precisa trapacear o sistema.</p><div id="dailyList"></div></article><article class="card"><h2>MISSÕES SEMANAIS</h2><div id="weeklyList"></div></article></div></section>
<section class="section" id="training"><div class="card"><h2>PROTOCOLO DE TREINAMENTO · 5 DIAS</h2><p class="tiny">Peso corporal · em casa · sem equipamentos. Faça aquecimento de 5–8 min. Ajuste repetições para manter técnica e esforço controlado.</p><div class="daytabs" id="dayTabs"></div><div id="workoutContent"></div><button class="btn primary" id="completeWorkout">Concluir treino do dia · +50 EXP</button></div></section>
<section class="section" id="attributes"><div class="grid"><article class="card wide"><h2>ATRIBUTOS DO JOGADOR</h2><p class="tiny">Os pontos representam consistência e atividades registradas, não são avaliações médicas ou medidas reais de capacidade.</p><div id="allAttrs"></div></article><article class="card"><h2>HABILIDADES DESBLOQUEADAS</h2><div id="skills"></div></article><article class="card"><h2>CLASSE ATUAL</h2><div class="big" id="className">Novato</div><p class="tiny" id="classDesc">Todo jogador começa em algum lugar.</p></article></div></section>
<section class="section" id="history"><div class="card"><h2>REGISTRO DE EVOLUÇÃO</h2><div id="historyList"></div><button class="btn" id="exportData">Exportar backup (.json)</button> <button class="btn" id="importButton">Importar backup</button><input type="file" id="importFile" accept="application/json" hidden></div></section>
<section class="section" id="rewards"><div class="grid"><article class="card wide"><h2>CONQUISTAS</h2><div id="achievements"></div></article><article class="card"><h2>INVENTÁRIO DE HABILIDADES</h2><div id="skillInventory"></div></article></div></section>
</div><div class="toast" id="toast"></div><div class="footer">DISCIPLINA · CONSISTÊNCIA · EVOLUÇÃO</div>
<script>
const $=s=>document.querySelector(s), $$=s=>[...document.querySelectorAll(s)];
const today=()=>new Date().toLocaleDateString('en-CA');
const dayIndex=()=>{let d=new Date().getDay();return d===0?6:d-1};
const defaults={
 xp:0,level:1,workouts:0,streak:0,lastWorkout:null,completed:{},weekly:{},history:[],attrs:{forca:1,resistencia:1,mobilidade:1,disciplina:1,intelecto:1},name:"JOGADOR",timer:90
};
let state={...defaults,...JSON.parse(localStorage.getItem('playerSystemV2')||'{}')};
state.attrs={...defaults.attrs,...(state.attrs||{})};state.completed=state.completed||{};state.weekly=state.weekly||{};state.history=state.history||[];
const daily=[
 ["Treino ou recuperação ativa conforme o plano",20],
 ["Beber água regularmente ao longo do dia",10],
 ["Realizar 5–10 min de mobilidade",10],
 ["Estudar ou praticar uma habilidade por 20 min",10],
 ["Manter horário adequado de sono",10]
];
const weekly=[
 ["Completar 5 sessões de treino",60,()=>state.workouts%100>=5],
 ["Fazer 2 sessões leves de mobilidade",30,()=>Object.keys(state.completed).filter(k=>k.startsWith('mob-')).length>=2],
 ["Revisar o progresso da semana",20,()=>state.weekly.review]
];
const plans=[
 {name:"SEG · Peito + tríceps",focus:"Empurrar",items:[["Flexão tradicional","3 × 8–15"],["Flexão com mãos próximas","3 × 6–12"],["Flexão inclinada ou com joelhos","2 × 10–15"],["Prancha","3 × 30–45 s"]]},
 {name:"TER · Pernas",focus:"Força inferior",items:[["Agachamento","4 × 12–20"],["Afundo reverso","3 × 8–12 por perna"],["Elevação pélvica","3 × 15–20"],["Panturrilha em pé","3 × 15–25"],["Wall sit","2 × 30–45 s"]]},
 {name:"QUA · Condicionamento + core",focus:"Resistência",items:[["Polichinelo baixo impacto ou normal","3 × 40 s"],["Mountain climber controlado","3 × 20–30 s"],["Dead bug","3 × 10 por lado"],["Prancha lateral","2 × 20–35 s por lado"],["Caminhada rápida no lugar","5 min"]]},
 {name:"QUI · Ombros + costas + mobilidade",focus:"Estabilidade",items:[["Pike push-up (variação adequada)","3 × 6–10"],["Superman","3 × 12–15"],["Y-T-W deitado","2 × 8 de cada posição"],["Bird dog","3 × 10 por lado"],["Mobilidade de ombros e coluna","6–8 min"]]},
 {name:"SEX · Corpo inteiro",focus:"Integração",items:[["Flexão","3 × 8–12"],["Agachamento com pausa","3 × 12–15"],["Afundo alternado","3 × 10 por perna"],["Ponte de glúteos","3 × 15"],["Prancha","3 × 30–45 s"]]}
];
let selectedDay=Math.min(dayIndex(),4),seconds=90,interval=null;
function save(){localStorage.setItem('playerSystemV2',JSON.stringify(state));$('#saveStatus').textContent='● SALVO';}
function toast(t){let el=$('#toast');el.textContent=t;el.style.display='block';setTimeout(()=>el.style.display='none',2200)}
function levelUp(){while(state.xp>=state.level*100){state.xp-=state.level*100;state.level++;toast('NÍVEL AUMENTOU! Nível '+state.level)}}
function addXP(n,reason){state.xp+=n;levelUp();state.history.unshift({date:today(),text:reason,xp:n});state.history=state.history.slice(0,80);save();render()}
function dateKey(){return today()}
function dailyKey(i){return dateKey()+'-'+i}
function completeDaily(i,checked){let k=dailyKey(i);if(checked&&!state.completed[k]){state.completed[k]=true;addXP(daily[i][1],'Missão diária: '+daily[i][0])}else if(!checked&&state.completed[k]){delete state.completed[k];state.xp=Math.max(0,state.xp-daily[i][1]);save();render()}}
function renderMissions(){
 $('#dailyList').innerHTML=daily.map((m,i)=>`<label class="mission ${state.completed[dailyKey(i)]?'done':''}"><input type="checkbox" data-daily="${i}" ${state.completed[dailyKey(i)]?'checked':''}><span class="mname">${m[0]}</span><span class="reward">+${m[1]} EXP</span></label>`).join('');
 $('#weeklyList').innerHTML=weekly.map((m,i)=>`<div class="mission"><span class="mname">${m[0]}</span><span class="reward">+${m[1]} EXP</span></div>`).join('')+`<button class="btn" id="weeklyReview">Registrar revisão semanal</button>`;
 $$('[data-daily]').forEach(x=>x.onchange=()=>completeDaily(+x.dataset.daily,x.checked));
 $('#weeklyReview').onclick=()=>{if(!state.weekly.review){state.weekly.review=true;addXP(20,'Revisão semanal')}};
 let done=daily.filter((m,i)=>state.completed[dailyKey(i)]).length;
 $('#todayMission').innerHTML=`<div class="big">${done}/${daily.length}</div><div class="tiny">missões diárias concluídas</div><div class="bar"><span style="width:${done/daily.length*100}%"></span></div><button class="btn" style="margin-top:10px" onclick="document.querySelector('[data-tab=missions]').click()">Ver missões</button>`;
}
function renderWorkout(){
 $('#dayTabs').innerHTML=plans.map((p,i)=>`<button class="${selectedDay===i?'active':''}" data-day="${i}">${['SEG','TER','QUA','QUI','SEX'][i]}</button>`).join('');
 $$('[data-day]').forEach(b=>b.onclick=()=>{selectedDay=+b.dataset.day;renderWorkout()});
 let p=plans[selectedDay];$('#workoutContent').innerHTML=`<div class="kicker">${p.focus}</div><h3>${p.name}</h3>${p.items.map(it=>`<div class="exercise"><div><strong>${it[0]}</strong><small>Controle a execução e mantenha a respiração</small></div><div class="sets">${it[1]}</div></div>`).join('')}<p class="tiny">Descanso: 60–120 s entre séries. Finalize com 3–5 min de volta à calma.</p>`;
 $('#completeWorkout').disabled=!!state.completed['workout-'+today()+'-'+selectedDay];
}
function classFor(){if(state.level>=30)return ['Monarca','Consistência lendária.'];if(state.level>=20)return ['Soberano','Seu progresso já é sólido.'];if(state.level>=10)return ['Elite','Você construiu uma boa base.'];if(state.level>=5)return ['Caçador','A disciplina está ganhando forma.'];return ['Novato','Todo jogador começa em algum lugar.']}
const attrNames={forca:'FORÇA',resistencia:'RESISTÊNCIA',mobilidade:'MOBILIDADE',disciplina:'DISCIPLINA',intelecto:'INTELECTO'};
function renderAttrs(){let html=Object.entries(attrNames).map(([k,n])=>`<div class="attr"><span>${n}</span><b>${state.attrs[k]}</b><div class="bar"><span style="width:${Math.min(100,state.attrs[k]*5)}%"></span></div></div>`).join('');$('#allAttrs').innerHTML=html;$('#miniAttrs').innerHTML=html}
function renderHistory(){$('#historyList').innerHTML=state.history.length?state.history.map(h=>`<div class="historyitem"><b>${h.text}</b><div class="tiny">${h.date} · +${h.xp} EXP</div></div>`).join(''):'<p class="tiny">Nenhum registro ainda. Sua primeira missão inicia o histórico.</p>'}
function renderAchievements(){let a=[['Primeiro passo','Conclua sua primeira missão',Object.keys(state.completed).length>0||state.workouts>0],['Em movimento','Complete 5 treinos',state.workouts>=5],['Caçador consistente','Alcance o nível 5',state.level>=5],['Disciplina de aço','Alcance o nível 10',state.level>=10],['Evolução contínua','Complete 20 treinos',state.workouts>=20]];$('#achievements').innerHTML=a.map(x=>`<div class="achievement"><b>${x[2]?'🏆':'🔒'} ${x[0]}</b><div class="tiny">${x[1]}</div><span class="tiny">${x[2]?'DESBLOQUEADA':'BLOQUEADA'}</span></div>`).join('')}
function render(){
 $('#level').textContent=String(state.level).padStart(2,'0');$('#xpText').textContent=`${state.xp} / ${state.level*100} EXP`;$('#xpBar').style.width=(state.xp/(state.level*100)*100)+'%';
 $('#streak').textContent=state.streak+' dias';$('#workouts').textContent=state.workouts;$('#missionsDone').textContent=Object.keys(state.completed).filter(k=>k.startsWith(today())).length;
 let c=classFor();$('#rank').textContent=c[0];$('#className').textContent=c[0];$('#classDesc').textContent=c[1];
 renderAttrs();renderMissions();renderWorkout();renderHistory();renderAchievements();
 let skills=[['Fundamentos','Desbloqueada no início',true],['Ritmo de treino','Complete 3 treinos',state.workouts>=3],['Resiliência','Alcance nível 5',state.level>=5],['Foco absoluto','Alcance nível 10',state.level>=10]];
 $('#skills').innerHTML=skills.map(s=>`<div class="skill"><b>${s[2]?'✦':'◇'} ${s[0]}</b><div class="tiny">${s[1]}</div></div>`).join('');$('#skillInventory').innerHTML=$('#skills').innerHTML;
 $('#weekStatus').innerHTML=plans.map((p,i)=>`<div class="tiny" style="padding:5px 0">${['SEG','TER','QUA','QUI','SEX'][i]} ${state.completed['week-'+i]?'✓':'○'} · ${p.focus}</div>`).join('');
}
$$('#nav button').forEach(b=>b.onclick=()=>{$$('#nav button').forEach(x=>x.classList.remove('active'));b.classList.add('active');$$('.section').forEach(x=>x.classList.remove('active'));$('#'+b.dataset.tab).classList.add('active')});
$('#completeWorkout').onclick=()=>{let key='workout-'+today()+'-'+selectedDay;if(state.completed[key])return;state.completed[key]=true;state.completed['week-'+selectedDay]=true;state.workouts++;state.attrs.forca+=selectedDay===0||selectedDay===1||selectedDay===3||selectedDay===4?1:0;state.attrs.resistencia+=selectedDay===2||selectedDay===4?1:0;state.attrs.mobilidade+=selectedDay===2||selectedDay===3?1:0;state.attrs.disciplina++;if(state.lastWorkout!==today()){let yesterday=new Date(Date.now()-86400000).toLocaleDateString('en-CA');state.streak=state.lastWorkout===yesterday?state.streak+1:1;state.lastWorkout=today()}addXP(50,'Treino concluído: '+plans[selectedDay].name);toast('TREINO REGISTRADO · +50 EXP')};
function clockText(){let m=Math.floor(seconds/60),s=seconds%60;$('#clock').textContent=String(m).padStart(2,'0')+':'+String(s).padStart(2,'0')}
$('#timerStart').onclick=()=>{if(interval){clearInterval(interval);interval=null;$('#timerStart').textContent='Continuar';return}$('#timerStart').textContent='Pausar';interval=setInterval(()=>{if(seconds>0){seconds--;clockText()}else{clearInterval(interval);interval=null;$('#timerStart').textContent='Iniciar';toast('DESCANSO FINALIZADO')}} ,1000)};
$('#timerReset').onclick=()=>{clearInterval(interval);interval=null;seconds=90;clockText();$('#timerStart').textContent='Iniciar'};
$('#exportData').onclick=()=>{let blob=new Blob([JSON.stringify(state,null,2)],{type:'application/json'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='player-system-backup.json';a.click();URL.revokeObjectURL(a.href)};
$('#importButton').onclick=()=>$('#importFile').click();
$('#importFile').onchange=async e=>{try{let x=JSON.parse(await e.target.files[0].text());if(!('xp'in x&&'level'in x))throw 0;state={...defaults,...x};save();render();toast('Backup importado')}catch{toast('Arquivo de backup inválido')}};
if('serviceWorker'in navigator&&location.protocol!=='file:')window.addEventListener('load',()=>navigator.serviceWorker.register('./sw.js').catch(()=>{}));
render();clockText();
</script>
</body></html>
