<style>
:root{--bg:#070b14;--panel:#101a2b;--panel2:#0b1422;--line:#263d5d;--cyan:#65dcff;--blue:#258cff;--muted:#91a4bd;--white:#edf6ff;--gold:#f6c96b;--green:#63e6b0;--red:#ff7185}
