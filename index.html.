.top:after{content:"";position:absolute;width:230px;height:230px;border:1px solid #3d80b9;border-radius:50%;right:-100px;top:-145px;box-shadow:0 0 0 24px #1b56801c,0 0 0 50px #1b568012}
.kicker{font-size:10px;letter-spacing:4px;color:#8db8df;text-transform:uppercase}.brand{font-weight:900;font-size:clamp(24px,7vw,34px);letter-spacing:1px;color:var(--cyan);margin:8px 0 4px;text-shadow:0 0 22px #49baff55}.subtitle{font-size:11px;letter-spacing:3px;color:#9fb4ce}.toprow{display:flex;justify-content:space-between;align-items:center;gap:12px;position:relative;z-index:1}.status-pill{font-size:10px;border:1px solid #3e9b89;color:var(--green);border-radius:30px;padding:7px 10px;white-space:nowrap}
main{max-width:850px;margin:auto;padding:16px 14px 100px}.hero{border:1px solid #38628c;border-radius:20px;padding:20px;background:linear-gradient(135deg,#142943,#0d1727 70%);box-shadow:0 12px 35px #0005;position:relative;overflow:hidden}.hero:after{content:"";position:absolute;width:190px;height:190px;border:1px solid #3476a2;border-radius:50%;right:-100px;top:-110px;box-shadow:0 0 0 20px #2875a015,0 0 0 42px #2875a010}
.hero-label{font-size:11px;letter-spacing:3px;color:#65bfff}.hero h1{font-size:27px;margin:12px 0 3px}.muted{color:var(--muted)}.rank{color:var(--cyan);font-weight:800;letter-spacing:2px}.hero-meta{display:flex;justify-content:space-between;align-items:end;gap:10px;margin-top:24px}.level{font-size:39px;font-weight:900;color:var(--cyan);line-height:1}.xp{text-align:right;color:#c6d7e9;font-size:13px}.bar{height:11px;background:#07101d;border:1px solid #34516e;border-radius:20px;overflow:hidden;margin-top:14px}.bar>span{display:block;height:100%;width:0;background:linear-gradient(90deg,#1677df,#65e5ff);box-shadow:0 0 14px #4bcaff;transition:width .35s}
.tabs{display:flex;gap:8px;overflow-x:auto;padding:14px 0 12px;scrollbar-width:thin}.tabs button{flex:0 0 auto;border:1px solid #2c4c70;background:#10243a;color:#c8d9ec;border-radius:12px;padding:11px 15px}.tabs button.active{background:#1269a5;border-color:#54cfff;color:white;box-shadow:0 0 18px #168bca55}
.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.card{background:linear-gradient(145deg,#111e30,#0c1523);border:1px solid var(--line);border-radius:17px;padding:16px;margin:0 0 12px;box-shadow:0 8px 24px #0002}.card h2{margin:0 0 14px;font-size:16px;letter-spacing:1.4px;color:#7edfff}.card h3{font-size:14px;margin:0 0 8px}.metric{background:#0a1422;border:1px solid #263f5b;border-radius:13px;padding:13px;min-height:83px}.metric small{display:block;color:var(--muted);font-size:10px;letter-spacing:1px;text-transform:uppercase}.metric strong{display:block;font-size:24px;margin-top:6px}
.section{display:none}.section.active{display:block}.mission{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px 0;border-bottom:1px solid #26364b}.mission:last-child{border:0}.mission.done .mname{text-decoration:line-through;color:#8092a8}.mname{font-size:14px;font-weight:600}.mmeta{font-size:11px;color:var(--muted);margin-top:4px}.btn{border:1px solid #4a9dd2;background:linear-gradient(135deg,#1769b0,#124c86);color:white;border-radius:10px;padding:10px 13px;font-weight:700;font-size:12px}.btn:disabled{opacity:.4;cursor:not-allowed}.btn.secondary{background:#12243a;border-color:#365271;color:#cde5fa}.btn.danger{background:#421d2a;border-color:#944457}.btn.gold{background:#604719;border-color:#b88a39;color:#ffe5a7}.btn.small{padding:7px 9px}.formrow{display:flex;gap:8px;margin-top:10px}.formrow input,.formrow select,.field{min-width:0;width:100%;background:#081321;border:1px solid #304966;border-radius:10px;color:white;padding:11px;outline:none}.formrow input:focus,.field:focus{border-color:var(--cyan)}.statrow{margin:14px 0}.stathead{display:flex;justify-content:space-between;font-size:13px;margin-bottom:7px}.statbar{height:8px;background:#07101b;border:1px solid #29415e;border-radius:20px;overflow:hidden}.statbar span{display:block;height:100%;background:linear-gradient(90deg,#1677d8,#5be0ff)}.smalltext{font-size:11px;color:var(--muted);line-height:1.5}.notice{border-left:3px solid var(--cyan);padding:10px 12px;background:#0c2033;border-radius:0 9px 9px 0;color:#bfd9ef;font-size:12px;margin:12px 0}.tag{display:inline-block;border:1px solid #355676;border-radius:20px;padding:4px 8px;color:#9edfff;font-size:10px;margin:3px}.empty{text-align:center;padding:22px;color:var(--muted);font-size:13px}.record{display:flex;justify-content:space-between;gap:10px;padding:10px 0;border-bottom:1px solid #24364b;font-size:12px}.record:last-child{border:0}.record strong{color:var(--green)}.footer{text-align:center;color:#647c98;font-size:10px;letter-spacing:2px;padding:24px 0 10px}.toast{position:fixed;left:50%;bottom:25px;transform:translate(-50%,20px);background:#122d45;border:1px solid #58cfff;color:#e8f8ff;padding:12px 17px;border-radius:12px;opacity:0;pointer-events:none;transition:.25s;z-index:9;box-shadow:0 8px 30px #0009;font-size:13px}.toast.show{opacity:1;transform:translate(-50%,0)}.hidden{display:none!important}
@media(max-width:560px){.grid{grid-template-columns:repeat(2,minmax(0,1fr))}.hero{padding:18px}.card{padding:14px}.mission{align-items:flex-start}.mission .btn{white-space:nowrap}.mname{font-size:13px}}
</style>

